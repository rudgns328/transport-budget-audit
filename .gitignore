# 비밀
.env

# 원본 데이터 (사용자가 직접 내려받음, 재배포하지 않음)
data/raw/

# 정제 중간 산출물 (01 단계에서 원본으로부터 재생성)
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS·편집기
.DS_Store
.vscode/
.idea/

# 엑셀 임시 파일
~$*

# 시연 결과 (실행마다 달라짐)
outputs/demo/

# 분석보고서와 생성 스크립트, 주최 측 원본 양식 (보고서는 이메일로 따로 제출, 저장소에 올리지 않음)
